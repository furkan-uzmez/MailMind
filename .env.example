# Email Credentials (REQUIRED)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# IMAP Server Settings
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# SMTP Server Settings (for sending replies)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ═══════════════════════════════════════════════════════════════════════
# PROVIDER SELECTION - Switch between local and cloud services
# ═══════════════════════════════════════════════════════════════════════

# LLM Provider: "ollama" (local), "openai" (cloud), or "gemini" (cloud)
LLM_PROVIDER=ollama

# STT Provider: "whisper" (local) or "openai_whisper" (cloud)
STT_PROVIDER=whisper

# TTS Provider: "edge" (free cloud) or "elevenlabs" (premium cloud)
TTS_PROVIDER=edge

# ═══════════════════════════════════════════════════════════════════════
# LOCAL PROVIDERS (Ollama, faster-whisper)
# ═══════════════════════════════════════════════════════════════════════

# Ollama Settings (local LLM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Whisper Settings (local STT)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# Edge TTS Voice (free cloud TTS)
TTS_VOICE=en-US-AriaNeural

# ═══════════════════════════════════════════════════════════════════════
# CLOUD PROVIDERS (Optional - only needed if using cloud providers)
# ═══════════════════════════════════════════════════════════════════════

# OpenAI (for LLM and STT)
# OPENAI_API_KEY=sk-your-api-key
# OPENAI_MODEL=gpt-4o-mini

# Google Gemini (for LLM)
# GOOGLE_API_KEY=your-google-ai-key
# GEMINI_MODEL=gemini-pro

# ElevenLabs (for premium TTS)
# ELEVENLABS_API_KEY=your-elevenlabs-key
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Security
# Get a key from https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
SAFE_BROWSING_API_KEY=
